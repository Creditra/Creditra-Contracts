    "get_oracle_quorum_config": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "OracleQuorumConfigResponse",
      "description": "Response for oracle quorum configuration query.",
      "type": "object",
      "properties": {
        "config": {
          "anyOf": [
            {
              "$ref": "#/definitions/OracleQuorumConfig"
