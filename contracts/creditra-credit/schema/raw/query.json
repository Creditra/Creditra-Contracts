            "credit_line_id"
          ],
          "properties": {
            "credit_line_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "draw_id": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "proof_of_reserve"
      ],
      "properties": {
        "proof_of_reserve": {
          "type": "object",
